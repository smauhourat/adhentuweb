# El archivo de configuración nunca debe servirse por HTTP, ni siquiera si el
# servidor dejara de interpretar PHP (en ese caso se devolvería como texto plano).
<FilesMatch "^config(\.sample)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
